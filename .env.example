# Runtime selection: local development needs only the local Supabase stack; no remote credentials.
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000
MODEL_PROVIDER=deterministic
SANDBOX_PROVIDER=local
# `none` keeps the passwordless account-name login (local default).
# `supabase` switches guests and venue owners to Supabase Auth Google sign-in;
# it needs SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY, the Google provider enabled
# in the Supabase dashboard, and infra/supabase/migrations/0003_supabase_auth.sql applied.
AUTH_PROVIDER=none

# Note: tests never read .env — the vitest globalSetup (test/global-db-setup.ts)
# injects SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SERVICE_ROLE_KEY
# from the local Supabase stack. The values below only configure `pnpm dev`/`start`.
# Supabase (server only; REQUIRED — venue data always lives in Supabase).
# Local development: run `pnpm db:start` once, then copy the values printed by
# `pnpm db:status` (API URL → SUPABASE_URL, publishable/anon key, service_role key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for the venue backend and legacy management writes; never expose to browser code.
# Without it, management APIs fail closed with 503 while public reads keep working.
SUPABASE_SERVICE_ROLE_KEY=

# Product analytics (public-safe key; optional)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Text model adapters (server only). Preferred deployment path: MODEL_PROVIDER=openrouter.
# The model must support Structured Outputs; openai/gpt-5-mini is the initial low-cost baseline.
OPENROUTER_API_KEY=
MODEL_API_KEY=
MODEL_NAME=openai/gpt-5-mini

# Optional drink-photo background removal. `original` stores the upload unchanged.
IMAGE_CUTOUT_PROVIDER=original
IMAGE_CUTOUT_MODEL=qwen-image-3.0
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_ENDPOINT=

# Alibaba FC Sandbox adapter (server/worker only; required when selected)
FC_SANDBOX_ENDPOINT=
FC_SANDBOX_API_KEY=

# E2B-compatible adapter (server/worker only; required when selected)
E2B_ENDPOINT=
E2B_API_KEY=
