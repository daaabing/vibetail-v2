# Runtime selection: local defaults require no external credentials.
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000
# RESTAURANT_REPOSITORY is a deprecated alias still honored for existing deployments.
VENUE_REPOSITORY=fixture
MODEL_PROVIDER=deterministic
SANDBOX_PROVIDER=local

# Supabase public reads (server only; URL + publishable key select the live repository)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional. Required only for legacy management and protected-table access; never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Product analytics (public-safe key; optional)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Text model adapters (server only). Preferred deployment path: MODEL_PROVIDER=openrouter.
# The model must support Structured Outputs; openai/gpt-5-mini is the initial low-cost baseline.
OPENROUTER_API_KEY=
MODEL_API_KEY=
MODEL_NAME=openai/gpt-5-mini

# Optional drink-photo background removal.
# - original: store the upload unchanged (default)
# - alibaba: DashScope generative cutout (requires DASHSCOPE_API_KEY)
# - sam2: local Meta SAM 2 sidecar (requires SAM2_CUTOUT_URL; see services/sam2-cutout/README.md)
IMAGE_CUTOUT_PROVIDER=original
IMAGE_CUTOUT_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_ENDPOINT=
SAM2_CUTOUT_URL=http://127.0.0.1:8091
# For sam2, IMAGE_CUTOUT_MODEL is a checkpoint name, e.g. sam2.1_hiera_small
# IMAGE_CUTOUT_MODEL=sam2.1_hiera_small
# For alibaba, IMAGE_CUTOUT_MODEL defaults to qwen-image-3.0
# IMAGE_CUTOUT_MODEL=qwen-image-3.0

# Alibaba FC Sandbox adapter (server/worker only; required when selected)
FC_SANDBOX_ENDPOINT=
FC_SANDBOX_API_KEY=

# Alibaba AgentRun sandbox adapter (server/worker only). Read directly by
# `@agentrun/sdk`; not yet validated by apps/web/src/env.ts because no runtime
# path constructs the adapter. AGENTRUN_REGION defaults to cn-hangzhou.
AGENTRUN_ACCESS_KEY_ID=
AGENTRUN_ACCESS_KEY_SECRET=
AGENTRUN_ACCOUNT_ID=
AGENTRUN_REGION=

# E2B-compatible adapter (server/worker only; required when selected)
E2B_ENDPOINT=
E2B_API_KEY=
