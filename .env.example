# Runtime selection: local defaults require no external credentials.
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000
RESTAURANT_REPOSITORY=fixture
MODEL_PROVIDER=deterministic
SANDBOX_PROVIDER=local

# Supabase public reads (server only; URL + publishable key select the live repository)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional. Required only for legacy management and protected-table access; never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Product analytics (public-safe key; optional)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Text model adapter (server only; required for non-deterministic providers)
MODEL_API_KEY=
MODEL_NAME=

# Alibaba FC Sandbox adapter (server/worker only; required when selected)
FC_SANDBOX_ENDPOINT=
FC_SANDBOX_API_KEY=

# E2B-compatible adapter (server/worker only; required when selected)
E2B_ENDPOINT=
E2B_API_KEY=
