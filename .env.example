# Runtime selection: local development needs only the local Supabase stack; no remote credentials.
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000
MODEL_PROVIDER=deterministic
SANDBOX_PROVIDER=local
# Default. Supabase Auth on the venue backend: email/password works out of the
# box; the Google button is always shown and needs the OAuth client from
# docs/operations/google-auth-setup.md to complete (clicking it earlier shows
# an in-app notice instead). Needs SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY and
# infra/supabase/migrations/0003_supabase_auth.sql applied.
# `none` is the legacy passwordless account-name login, kept for the tests that
# still cover it; it grants access to anyone who guesses an account name.
AUTH_PROVIDER=supabase

# Address autocomplete upstream for venue onboarding (optional). Defaults to
# the public Photon instance (https://photon.komoot.io) — fine for dev and low
# volume, no key needed. Point it at a self-hosted Photon or another
# Photon-compatible proxy when volume outgrows the public instance.
# GEOCODE_BASE_URL=https://photon.example.com

# Note: tests never read .env — the vitest globalSetup (test/global-db-setup.ts)
# injects SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SERVICE_ROLE_KEY
# from the local Supabase stack. The values below only configure `pnpm dev`/`start`.
# Supabase (server only; REQUIRED — venue data always lives in Supabase).
# Local development: run `pnpm db:start` once, then copy the values printed by
# `pnpm db:status` (API URL → SUPABASE_URL, publishable/anon key, service_role key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for the venue backend and legacy management writes; never expose to browser code.
# Without it, management APIs fail closed with 503 while public reads keep working.
SUPABASE_SERVICE_ROLE_KEY=

# Product analytics (public-safe key; optional)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Text model adapters (server only). Preferred deployment path: MODEL_PROVIDER=openrouter.
# The model must support Structured Outputs; openai/gpt-5-mini is the initial low-cost baseline.
OPENROUTER_API_KEY=
MODEL_API_KEY=
MODEL_NAME=openai/gpt-5-mini
# OpenRouter menu-photo vision model; defaults to the free router when omitted.
MENU_PHOTO_MODEL=openrouter/free

# Optional drink-photo background removal.
# - original: store the upload unchanged (default)
# - sam2: local Meta SAM 2 sidecar (requires SAM2_CUTOUT_URL; see services/sam2-cutout/README.md)
IMAGE_CUTOUT_PROVIDER=original
IMAGE_CUTOUT_MODEL=
SAM2_CUTOUT_URL=http://127.0.0.1:8091
# For sam2, IMAGE_CUTOUT_MODEL is a checkpoint name, e.g. sam2.1_hiera_small
# IMAGE_CUTOUT_MODEL=sam2.1_hiera_small
# Alibaba FC Sandbox adapter (server/worker only; required when selected)
FC_SANDBOX_ENDPOINT=
FC_SANDBOX_API_KEY=

# Alibaba AgentRun sandbox adapter (server/worker only). Read directly by
# `@agentrun/sdk`; not yet validated by apps/web/src/env.ts because no runtime
# path constructs the adapter. AGENTRUN_REGION defaults to cn-hangzhou.
AGENTRUN_ACCESS_KEY_ID=
AGENTRUN_ACCESS_KEY_SECRET=
AGENTRUN_ACCOUNT_ID=
AGENTRUN_REGION=

# E2B-compatible adapter (server/worker only; required when selected)
E2B_ENDPOINT=
E2B_API_KEY=
