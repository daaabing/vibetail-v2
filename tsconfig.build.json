{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": ".build",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["apps/**/src/**/*.ts", "apps/**/src/**/*.tsx", "packages/**/src/**/*.ts", "packages/**/src/**/*.tsx"],
  "exclude": ["**/*.test.ts", "node_modules", ".build", "dist"]
}
